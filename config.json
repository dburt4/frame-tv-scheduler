    },

    {
      "_comment": "Halloween — October 31st, annual",
      "name": "halloween",
      "date": "10-31",
      "source": "halloween",
      "mode": "random",
      "interval_minutes": null
    },

    {
      "_comment": "Thanksgiving 2026 — moving date (4th Thursday of November). 2026: Nov 26. Update each year.",
      "name": "thanksgiving",
      "date": "2026-11-26",
      "source": "thanksgiving",
      "mode": "random",
      "interval_minutes": null
    },

    {
      "_comment": "Christmas season — Nov 29 through Dec 31. Sundays in this range are handled by the sunday-christmas rules above.",
      "name": "christmas",
      "date_range": {"start": "11-29", "end": "12-31"},
      "source": "christmas",
      "mode": "random",
      "interval_minutes": 90
    },

    {
      "_comment": "Every Sunday (non-holiday). Comes after specific holiday dates so Easter etc. take precedence.",
      "name": "sunday-art",
      "weekdays": ["sunday"],
      "source": "sunday",
      "mode": "random",
      "interval_minutes": 60
    },


    {
      "_comment": "Default — used whenever no other rule matches",
      "name": "default",
      "source": "my_photos",
      "mode": "random",
      "interval_minutes": 60
    }
  ]
