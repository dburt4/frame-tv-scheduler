  "schedules": [
    {
      "_comment": "Easter Sunday 2026 — moving date, update this each year. 2027: Apr 25. Check https://www.timeanddate.com/holidays/",
      "name": "easter-sunday",
      "date": "2026-04-05",
      "source": "easter_sunday",
      "mode": "random",
      "interval_minutes": 60
    },

    {
      "_comment": "Christmas Sundays 2026 — listed individually because the scheduler can't combine weekday + date range. Update these each year.",
